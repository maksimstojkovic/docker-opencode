#!/bin/sh
# Pre-shell wrapper invoked as opencode user's login shell.
#
# TEMP: RIS (\033c) buffer-flash workaround removed to test whether the
# Debian/glibc switch resolves opencode's ghost-text bug on new "+" tabs.
# Restore with: git checkout -- root/usr/local/bin/opencode-shell
#               git checkout -- root/etc/profile.d/00-opencode.sh

# Land in /workspace when opencode didn't pick a meaningful cwd. If the
# user has a project selected, opencode passes its path (e.g.
# /workspace/my-app) — respect that. Only override the "no choice" cases:
# cwd == / (opencode's default for unscoped terminals) or cwd == $HOME
# (some launchers default here). Skip entirely for non-tty invocations.
if [ -t 1 ] && [ -d /workspace ]; then
    cwd="${PWD:-$(pwd 2>/dev/null || echo /)}"
    case "$cwd" in
        / | "$HOME" | "") cd /workspace 2>/dev/null || true ;;
    esac
    unset cwd
fi

exec /bin/bash "$@"
