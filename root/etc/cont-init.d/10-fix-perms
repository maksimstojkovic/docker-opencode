#!/command/with-contenv sh
# Reconcile the in-image opencode user UID/GID with the host's PUID/PGID,
# then chown the persistent bind-mounts so the agent can read/write them.
#
# Shebang note: MUST be /command/with-contenv — plain `env sh` runs without
# the container's ENV (so PUID/PGID from Dockerfile are unset) and the
# script aborts under `set -u`, leaving /workspace root-owned.

set -eu

log() { printf '[fix-perms] %s\n' "$*"; }

: "${PUID:=1000}"
: "${PGID:=1000}"

log "starting (PUID=${PUID} PGID=${PGID})"

if [ "$(id -u opencode)" != "${PUID}" ]; then
    log "remapping opencode uid $(id -u opencode) -> ${PUID}"
    usermod -o -u "${PUID}" opencode
fi
if [ "$(id -g opencode)" != "${PGID}" ]; then
    log "remapping opencode gid $(id -g opencode) -> ${PGID}"
    groupmod -o -g "${PGID}" opencode
fi

for dir in /config /workspace; do
    log "chown -R opencode:opencode ${dir}"
    if ! chown -R opencode:opencode "${dir}" 2>/tmp/fix-perms.err; then
        log "WARN: chown ${dir} failed -- $(tr '\n' ' ' </tmp/fix-perms.err)"
        log "      (common on Docker Desktop bind-mounts or NFS without no_root_squash)"
    fi
done

# /ssh holds user-supplied SSH keys. Read-only mounts are a recommended
# setup (host owns the keys, container reads only), so detect that case
# and skip silently. `[ -w ]` reports writable for root even on ro mounts
# thanks to CAP_DAC_OVERRIDE, so probe with an actual write attempt.
if [ -d /ssh ] && touch /ssh/.fix-perms-probe 2>/dev/null; then
    rm -f /ssh/.fix-perms-probe
    log "tightening /ssh permissions (mount is writable)"
    chown -R opencode:opencode /ssh
    chmod 700 /ssh
    find /ssh -maxdepth 1 -type f -name 'id_*' ! -name '*.pub' -exec chmod 600 {} \;
    find /ssh -maxdepth 1 -type f \( -name '*.pub' -o -name 'known_hosts' -o -name 'config' \) -exec chmod 644 {} \;
elif [ -d /ssh ]; then
    log "/ssh is read-only — leaving host permissions intact (recommended for key material)"
fi

rm -f /tmp/fix-perms.err
log "complete"
