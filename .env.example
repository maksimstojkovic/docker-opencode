# Copy to .env (gitignored).

# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional alt providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Host user mapping (run `id` to find yours)
PUID=1000
PGID=1000
TZ=Australia/Melbourne

# Dev-only: opencode version pin for local builds
# OPENCODE_VERSION=1.15.10
