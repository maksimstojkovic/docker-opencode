# Copy to .env (gitignored).

# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default models seeded into opencode.json on first start. Only applied if
# /config/.config/opencode/opencode.json does not exist yet — edit that file
# directly to change models after first run. Any id from
# https://openrouter.ai/models works.
# OPENROUTER_MODEL=moonshotai/kimi-k2.6
# OPENROUTER_SMALL_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional alt providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Host user mapping (run `id` to find yours)
PUID=1000
PGID=1000
TZ=Australia/Sydney

# Dev-only: opencode version pin for local builds
# OPENCODE_VERSION=1.15.10
