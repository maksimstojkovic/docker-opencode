# Copy to .env (gitignored).

# Required — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Seeded into opencode.json on first start only.
# OPENROUTER_MODEL=moonshotai/kimi-k2.6
# OPENROUTER_SMALL_MODEL=meta-llama/llama-3.1-8b-instruct

# imagegen MCP default. Also add to mcp.imagegen.environment in opencode.json.
# IMAGEGEN_DEFAULT_MODEL=google/gemini-3.1-flash-image-preview

# Optional alt providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional in-container HTTP basic auth.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# Host user mapping (run `id` to find yours)
PUID=1000
PGID=1000
TZ=Australia/Sydney

# Dev-only: opencode version pin for local builds
# OPENCODE_VERSION=1.15.10
